# PerfectOCR/third_party/opencv_dep/opencv_config.cmake
if(DEFINED ENV{CONDA_PREFIX})
    set(CONDA_ENV "$ENV{CONDA_PREFIX}")
else()
    message(FATAL_ERROR "No se detectó un entorno Conda activo. Active el entorno previo a la configuración.")
endif()

if(NOT DEFINED ENV{OPENCV_DEP_DIR})
    message(FATAL_ERROR "OPENCV_DEP_DIR no está definido. Use el CMakeLists.txt de third_party/.")
endif()
set(_OCV_DEP_DIR "$ENV{OPENCV_DEP_DIR}")

if(WIN32 OR CMAKE_HOST_WIN32)
    if(NOT CMAKE_GENERATOR MATCHES "Visual Studio")
        set(CMAKE_C_COMPILER "icx" CACHE STRING "" FORCE)
        set(CMAKE_CXX_COMPILER "icx" CACHE STRING "" FORCE)
    endif()
    set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} /arch:AVX2" CACHE STRING "" FORCE)
    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} /arch:AVX2" CACHE STRING "" FORCE)
else()
    set(CMAKE_C_COMPILER "icx" CACHE STRING "" FORCE)
    set(CMAKE_CXX_COMPILER "icpx" CACHE STRING "" FORCE)
    set(CMAKE_C_FLAGS "-mavx2 -mf16c -mfma" CACHE STRING "" FORCE)
    set(CMAKE_CXX_FLAGS "-mavx2 -mf16c -mfma" CACHE STRING "" FORCE)
    set(CMAKE_EXE_LINKER_FLAGS "-L${CONDA_ENV}/lib -Wl,-rpath,${CONDA_ENV}/lib" CACHE STRING "" FORCE)
    set(CMAKE_SHARED_LINKER_FLAGS "-L${CONDA_ENV}/lib -Wl,-rpath,${CONDA_ENV}/lib" CACHE STRING "" FORCE)
endif()

set(CMAKE_INSTALL_PREFIX "${_OCV_DEP_DIR}/install" CACHE PATH "" FORCE)
set(CMAKE_PLATFORM_NO_VERSIONED_SONAME OFF CACHE BOOL "" FORCE)

set(CMAKE_BUILD_TYPE "Release" CACHE STRING "" FORCE)
set(CPU_BASELINE "AVX2" CACHE STRING "" FORCE)
set(CPU_DISPATCH "" CACHE STRING "" FORCE)

set(ENABLE_PRECOMPILED_HEADERS OFF CACHE BOOL "" FORCE)
set(OPENCV_WARNINGS_ARE_ERRORS OFF CACHE BOOL "" FORCE)

set(BUILD_opencv_core ON CACHE BOOL "" FORCE)
set(BUILD_opencv_imgproc ON CACHE BOOL "" FORCE)
set(BUILD_opencv_imgcodecs ON CACHE BOOL "" FORCE)

set(BUILD_LIST "core,imgproc,imgcodecs" CACHE STRING "" FORCE)
set(BUILD_SHARED_LIBS ON CACHE BOOL "" FORCE)

set(WITH_IPP ON CACHE BOOL "" FORCE)
set(WITH_TBB ON CACHE BOOL "" FORCE)
set(WITH_OPENMP OFF CACHE BOOL "" FORCE)

set(BUILD_PNG ON CACHE BOOL "" FORCE)
set(BUILD_JPEG ON CACHE BOOL "" FORCE)
set(BUILD_TIFF ON CACHE BOOL "" FORCE)
set(BUILD_WEBP ON CACHE BOOL "" FORCE)

set(WITH_CUDA OFF CACHE BOOL "" FORCE)
set(WITH_FFMPEG OFF CACHE BOOL "" FORCE)
set(WITH_GSTREAMER OFF CACHE BOOL "" FORCE)
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_PERF_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(BUILD_DOCS OFF CACHE BOOL "" FORCE)
set(BUILD_opencv_apps OFF CACHE BOOL "" FORCE)
set(WITH_V4L OFF CACHE BOOL "" FORCE)
set(WITH_LIBV4L OFF CACHE BOOL "" FORCE)