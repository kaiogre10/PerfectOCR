{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "generator": "Ninja",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CONDA_ENV": "$ENV{CONDA_DEFAULT_ENV}",
        "CONDA_PREFIX": "$ENV{CONDA_PREFIX}",
        "Python3_ROOT_DIR": "$ENV{CONDA_PREFIX}",
        "Python3_EXECUTABLE": "$ENV{CONDA_PREFIX}/python"
      }
    },
    {
      "name": "base-windows",
      "hidden": true,
      "inherits": "default",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-oneapi-vs",
      "inherits": "base-windows",
      "displayName": "Windows - OneAPI",
      "description": "Usa Ninja con OneAPI",
      "toolset": "Intel C++ Compiler 2026"
    },
    {
      "name": "windows-oneapi-clion",
      "inherits": "base-windows",
      "displayName": "Windows - OneAPI (CLion/Ninja)",
      "description": "Usa Ninja y compiladores icx nativos en CLion",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "icx"
      }
    },
    {
      "name": "windows-msvc",
      "inherits": "default",
      "displayName": "Windows - MSVC Nativo (x64)",
      "description": "Respaldo estándar de Windows",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "host=x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "default",
      "displayName": "Linux",
      "description": "Entorno base de Linux"
    },
    {
      "name": "linux-gcc",
      "inherits": "linux-base",
      "displayName": "Linux (GCC)",
      "description": "Entorno Linux GCC",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/gcc",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++"
      }
    },
    {
      "name": "linux-oneapi",
      "inherits": "linux-base",
      "displayName": "Linux (OneAPI)",
      "description": "Entorno Linux OneAPI",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "icx"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-oneapi-vs-release",
      "displayName": "Release (VS OneAPI)",
      "configurePreset": "windows-oneapi-vs",
      "configuration": "Release"
    },
    {
      "name": "win-oneapi-vs-debug",
      "displayName": "Debug (VS OneAPI)",
      "configurePreset": "windows-oneapi-vs",
      "configuration": "Debug"
    },
    {
      "name": "win-oneapi-clion-release",
      "displayName": "Release (CLion OneAPI)",
      "configurePreset": "windows-oneapi-clion",
      "configuration": "Release"
    },
    {
      "name": "win-oneapi-clion-debug",
      "displayName": "Debug (CLion OneAPI)",
      "configurePreset": "windows-oneapi-clion",
      "configuration": "Debug"
    },
    {
      "name": "win-msvc-debug",
      "displayName": "Debug (Windows MSVC)",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "win-msvc-release",
      "displayName": "Release (Windows MSVC)",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Release (Linux GCC)",
      "configurePreset": "linux-gcc",
      "configuration": "Release"
    },
    {
      "name": "linux-oneapi-release",
      "displayName": "Release (Linux OneAPI)",
      "configurePreset": "linux-oneapi",
      "configuration": "Release"
    }
  ]
}