{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "generator": "Ninja",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/libraries",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CONDA_ENV": "$ENV{CONDA_DEFAULT_ENV}",
        "CONDA_PREFIX": "$ENV{CONDA_PREFIX}",
        "Python3_ROOT_DIR": "$ENV{CONDA_PREFIX}",
        "Python3_EXECUTABLE": "$ENV{CONDA_PREFIX}/python"
      }
    },
    {
      "name": "base-windows",
      "hidden": true,
      "inherits": "default",
      "cacheVariables": {
        "Python3_EXECUTABLE": "$ENV{CONDA_PREFIX}/python.exe",
        "Python3_FIND_STRATEGY": "LOCATION"
      }
    },
    {
      "name": "type-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "type-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-oneapi-debug",
      "inherits": [ "base-windows", "type-debug" ],
      "generator": "Ninja",
      "displayName": "Windows - OneAPI (Debug)",
      "description": "Ninja con compiladores icx de OneAPI",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{ONEAPI_ROOT}/compiler/latest/bin/icx.exe",
        "CMAKE_CXX_COMPILER": "$env{ONEAPI_ROOT}/compiler/latest/bin/icx.exe"
      }
    },
    {
      "name": "windows-oneapi-release",
      "inherits": [ "base-windows", "type-release" ],
      "generator": "Ninja",
      "displayName": "Windows - OneAPI (Release)",
      "description": "Ninja con compiladores icx de OneAPI",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{ONEAPI_ROOT}/compiler/latest/bin/icx.exe",
        "CMAKE_CXX_COMPILER": "$env{ONEAPI_ROOT}/compiler/latest/bin/icx.exe"
      }
    },
    {
      "name": "windows-msvc-debug",
      "inherits": [ "base-windows", "type-debug" ],
      "displayName": "Windows - MSVC (Debug)",
      "description": "Ninja con MSVC nativo (fallback)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-msvc-release",
      "inherits": [ "base-windows", "type-release" ],
      "displayName": "Windows - MSVC (Release)",
      "description": "Ninja con MSVC nativo (fallback)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "default",
      "displayName": "Linux",
      "description": "Entorno base de Linux"
    },
    {
      "name": "linux-gcc",
      "inherits": "linux-base",
      "displayName": "Linux (GCC)",
      "description": "Entorno Linux GCC",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/gcc",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++"
      }
    },
    {
      "name": "linux-oneapi",
      "inherits": "linux-base",
      "displayName": "Linux (OneAPI)",
      "description": "Entorno Linux OneAPI",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "icx",
        "CMAKE_CXX_COMPILER": "icpx",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-oneapi-debug",
      "displayName": "Debug (Windows OneAPI)",
      "configurePreset": "windows-oneapi-debug"
    },
    {
      "name": "win-oneapi-release",
      "displayName": "Release (Windows OneAPI)",
      "configurePreset": "windows-oneapi-release"
    },
    {
      "name": "win-msvc-debug",
      "displayName": "Debug (Windows MSVC)",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "win-msvc-release",
      "displayName": "Release (Windows MSVC)",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Release (Linux GCC)",
      "configurePreset": "linux-gcc",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Debug (Linux GCC)",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    },
    {
      "name": "linux-oneapi-release",
      "displayName": "Release (Linux OneAPI)",
      "configurePreset": "linux-oneapi",
      "configuration": "Release"
    },
    {
      "name": "linux-oneapi-debug",
      "displayName": "Debug (Linux OneAPI)",
      "configurePreset": "linux-oneapi",
      "configuration": "Debug"
    }
  ]
}