{
  "version": 3,
  "configurePresets": [
    {
      "name": "base-global",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "base-windows-oneapi",
      "inherits": "base-global",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-oneapi-vs",
      "inherits": "base-windows-oneapi",
      "displayName": "Windows - OneAPI (Visual Studio)",
      "description": "Usa MSBuild y Toolset de Intel en VS 2026",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "Intel C++ Compiler 2026"
    },
    {
      "name": "windows-oneapi-clion",
      "inherits": "base-windows-oneapi",
      "displayName": "Windows - OneAPI (CLion/Ninja)",
      "description": "Usa Ninja y compiladores icx nativos en CLion",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "icx"
      }
    },
    {
      "name": "windows-msvc",
      "inherits": "base-global",
      "displayName": "Windows - MSVC Nativo (x64)",
      "description": "Respaldo estándar de Windows",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "host=x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-oneapi",
      "inherits": "base-global",
      "displayName": "Linux - Intel OneAPI",
      "description": "Usa icx/icpx en Linux mediante Ninja",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "icx",
        "CMAKE_CXX_COMPILER": "icpx"
      }
    },
    {
      "name": "linux-gcc",
      "inherits": "base-global",
      "displayName": "Linux - GCC Nativo",
      "description": "Respaldo estándar de Linux mediante Ninja",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-oneapi-vs-release",
      "displayName": "Release (VS OneAPI)",
      "configurePreset": "windows-oneapi-vs",
      "configuration": "Release"
    },
    {
      "name": "win-oneapi-vs-debug",
      "displayName": "Debug (VS OneAPI)",
      "configurePreset": "windows-oneapi-vs",
      "configuration": "Debug"
    },
    {
      "name": "win-oneapi-vs-relwithdebinfo",
      "displayName": "RelWithDebInfo (VS OneAPI)",
      "configurePreset": "windows-oneapi-vs",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "win-oneapi-clion-release",
      "displayName": "Release (CLion OneAPI)",
      "configurePreset": "windows-oneapi-clion",
      "configuration": "Release"
    },
    {
      "name": "win-oneapi-clion-debug",
      "displayName": "Debug (CLion OneAPI)",
      "configurePreset": "windows-oneapi-clion",
      "configuration": "Debug"
    },
    {
      "name": "win-oneapi-clion-relwithdebinfo",
      "displayName": "RelWithDebInfo (CLion OneAPI)",
      "configurePreset": "windows-oneapi-clion",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "win-msvc-debug",
      "displayName": "Debug (Windows MSVC)",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "win-msvc-release",
      "displayName": "Release (Windows MSVC)",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "linux-oneapi-debug",
      "displayName": "Debug (Linux OneAPI)",
      "configurePreset": "linux-oneapi",
      "configuration": "Debug"
    },
    {
      "name": "linux-oneapi-release",
      "displayName": "Release (Linux OneAPI)",
      "configurePreset": "linux-oneapi",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Release (Linux GCC)",
      "configurePreset": "linux-gcc",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Debug (Linux GCC)",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    }
  ]
}