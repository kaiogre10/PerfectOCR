{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-oneapi-vs",
      "inherits": "base-windows-oneapi",
      "displayName": "Windows - OneAPI (Visual Studio)",
      "description": "Usa MSBuild y Toolset de Intel en VS 2026",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "Intel C++ Compiler 2026"
    },
    {
      "name": "windows-oneapi-clion",
      "inherits": "base-windows-oneapi",
      "displayName": "Windows - OneAPI (CLion/Ninja)",
      "description": "Usa Ninja y compiladores icx nativos en CLion",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "icx"
      }
    },
    {
      "name": "windows-msvc",
      "inherits": "base-global",
      "displayName": "Windows - MSVC Nativo (x64)",
      "description": "Respaldo estándar de Windows",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "host=x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
