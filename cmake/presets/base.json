{
  "version": 3,
  "configurePresets": [
    {
      "name": "base-global",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "base-windows-oneapi",
      "inherits": "base-global",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ]
}